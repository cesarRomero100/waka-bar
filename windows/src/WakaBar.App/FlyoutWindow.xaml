<Window
    x:Class="WakaBar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WakaBar">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!-- First run: no API key yet. -->
                <StackPanel x:Name="NoKeyPanel" Spacing="10" Padding="0,32,0,0" Visibility="Collapsed">
                    <TextBlock
                        x:Uid="NoKeyTitle"
                        Text="No API key"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="NoKeyMessage"
                        Text="Add your WakaTime API key to see your stats."
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Uid="OpenSettingsButton"
                        Content="Open Settings…"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnOpenSettings" />
                </StackPanel>

                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" Margin="0,48" Visibility="Collapsed" />

                <StackPanel x:Name="StatsPanel" Spacing="14" Visibility="Collapsed">
                    <!-- Today (with the goal bar) and the last 7 days. -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="TodayLabel"
                                Text="Today"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TodayText" Style="{StaticResource TitleTextBlockStyle}" />
                            <StackPanel x:Name="GoalPanel" Width="160" Spacing="4" Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                <ProgressBar x:Name="GoalBar" Maximum="1" />
                                <TextBlock x:Name="GoalText" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Uid="LastSevenDaysLabel"
                                Text="Last 7 days"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="WeekText" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="AverageText"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Streak and today's top project. -->
                    <Grid x:Name="HighlightsRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StreakText" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            x:Name="TopProjectText"
                            x:Uid="TopProjectText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="Top project today"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>

                    <!-- One bar per day, built in code. -->
                    <Grid x:Name="ChartGrid" Height="120" ColumnSpacing="6" />

                    <SelectorBar x:Name="BreakdownBar" SelectionChanged="OnBreakdownChanged">
                        <SelectorBarItem x:Name="LanguagesItem" x:Uid="LanguagesItem" Text="Languages" IsSelected="True" />
                        <SelectorBarItem x:Name="ProjectsItem" x:Uid="ProjectsItem" Text="Projects" />
                    </SelectorBar>
                    <StackPanel x:Name="UsageList" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="ErrorText"
            Grid.Row="1"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCautionBrush}" />

        <Grid Grid.Row="2" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="UpdatedText"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="RefreshButton"
                x:Uid="RefreshButton"
                Grid.Column="1"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Refresh"
                Click="OnRefresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button
                x:Uid="MoreButton"
                Grid.Column="2"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="14" />
                <Button.Flyout>
                    <!-- Kept inside the window: a separate popup window would deactivate (and hide) this one. -->
                    <MenuFlyout Placement="TopEdgeAlignedRight" ShouldConstrainToRootBounds="True">
                        <!-- In-window menus use translucent in-app acrylic, which mixes with the stats behind. -->
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>
                        <MenuFlyoutItem x:Uid="MenuOpenDashboard" Text="Open dashboard" Click="OnOpenDashboard" />
                        <MenuFlyoutItem x:Uid="MenuSettings" Text="Settings…" Click="OnOpenSettings" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Uid="MenuQuit" Text="Quit WakaBar" Click="OnQuit" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>
