<Window
    x:Class="WakaBar.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WakaBar Settings">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock x:Uid="SettingsTitle" Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="LaunchAtStartupSwitch" x:Uid="LaunchAtStartupSwitch" Header="Launch at startup" Toggled="OnLaunchAtStartupToggled" />
                <TextBlock
                    x:Name="LaunchAtStartupNote"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ComboBox x:Name="GoalBox" x:Uid="GoalBox" Header="Daily goal" MinWidth="180" SelectionChanged="OnGoalChanged" />

            <StackPanel Spacing="4">
                <PasswordBox x:Name="ApiKeyBox" x:Uid="ApiKeyBox" Header="API key" PlaceholderText="waka_…" />
                <HyperlinkButton x:Uid="GetApiKeyLink" Content="Get your API key" Padding="0" NavigateUri="https://wakatime.com/settings/api-key" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox x:Name="ServerBox" x:Uid="ServerBox" Header="Server URL" PlaceholderText="https://api.wakatime.com/api/v1" />
                <TextBlock
                    x:Uid="ServerHint"
                    Text="Leave empty for WakaTime. For Wakapi use https://&lt;host&gt;/api/compat/wakatime/v1"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCautionBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <ProgressRing x:Name="SavingRing" Width="20" Height="20" IsActive="False" />
                <Button x:Name="SaveButton" x:Uid="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
            </StackPanel>

            <!-- Support WakaBar: free, open source, no tracking; ways to give back. Links in SupportLinks.cs. -->
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock x:Uid="SupportTitle" Text="Support WakaBar" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="SupportMessage"
                    Text="WakaBar is free and open source. No ads and no tracking: it only talks to your WakaTime server, and your API key stays in Windows Credential Manager."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CoffeeButton" Click="OnBuyMeACoffee">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="☕" />
                            <TextBlock x:Uid="CoffeeButtonText" Text="Buy me a coffee" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnStarOnGitHub">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⭐" />
                            <TextBlock x:Uid="StarButtonText" Text="Star it on GitHub" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="VersionText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
