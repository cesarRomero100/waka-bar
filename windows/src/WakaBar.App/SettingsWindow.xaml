<Window
    x:Class="WakaBar.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WakaBar Settings">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="LaunchAtStartupSwitch" Header="Launch at startup" Toggled="OnLaunchAtStartupToggled" />
                <TextBlock
                    x:Name="LaunchAtStartupNote"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ComboBox x:Name="GoalBox" Header="Daily goal" MinWidth="180" SelectionChanged="OnGoalChanged" />

            <StackPanel Spacing="4">
                <PasswordBox x:Name="ApiKeyBox" Header="API key" PlaceholderText="waka_…" />
                <HyperlinkButton Content="Get your API key" Padding="0" NavigateUri="https://wakatime.com/settings/api-key" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox x:Name="ServerBox" Header="Server URL" PlaceholderText="https://api.wakatime.com/api/v1" />
                <TextBlock
                    Text="Leave empty for WakaTime. For Wakapi use https://&lt;host&gt;/api/compat/wakatime/v1"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{ThemeResource SystemFillColorCautionBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <ProgressRing x:Name="SavingRing" Width="20" Height="20" IsActive="False" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
