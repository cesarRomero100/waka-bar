<Project Sdk="Microsoft.NET.Sdk">
  <!-- System tray app (WinUI 3), packaged as MSIX: required for launch at startup and the Widgets Board. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WakaBar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.cs provides Main, to keep a single instance running. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WakaBar.Core\WakaBar.Core.csproj" />
  </ItemGroup>

  <!-- Lets Visual Studio's single-project MSIX tooling activate before NuGet restore. -->
  <ItemGroup>
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
