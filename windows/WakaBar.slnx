<Solution>
  <!-- WinUI apps need a real platform; WakaBar.Core and the tests stay Any CPU. -->
  <Configurations>
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/WakaBar.App/WakaBar.App.csproj">
      <!-- C# projects default to Any CPU, which WinUI doesn't support: map each platform explicitly. -->
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
      <!-- Deploy registers the MSIX package, so F5 in Visual Studio installs and runs it.
           Listed per platform: a bare <Deploy /> wasn't always picked up by Visual Studio. -->
      <Deploy Solution="*|x64" />
      <Deploy Solution="*|ARM64" />
    </Project>
    <Project Path="src/WakaBar.Core/WakaBar.Core.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/WakaBar.Core.Tests/WakaBar.Core.Tests.csproj" />
  </Folder>
</Solution>
